                <div class="inline-flex gap-1">
                  <button onclick="recordArrival('${m.id}')" class="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-500 text-white rounded text-xs font-bold">Check-In</button>
                  <button onclick="recordArrival('${m.id}', 'late')" class="px-2.5 py-1 bg-amber-600 hover:bg-amber-500 text-white rounded text-xs font-bold">Late</button>
                  <button onclick="recordArrival('${m.id}', 'absent')" class="px-2.5 py-1 bg-rose-700 hover:bg-rose-600 text-white rounded text-xs font-bold">Absent</button>
                </div>
              </td>
            </tr>
          `;
        }).join("");
      } else {
        btnOpen.classList.remove("hidden");
        btnClose.classList.add("hidden");
        banner.className = "p-4 rounded-xl border border-slate-800 bg-slate-950 text-xs text-slate-400 text-center";
        banner.innerText = "No meeting session currently open. Tap 'Launch Meeting Session' to begin.";
        mobileCards.innerHTML = `<div class="p-4 text-center text-slate-500 text-xs">Register is currently idle.</div>`;
        desktopTable.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-slate-500">Register is currently idle.</td></tr>`;
      }
    }

    function renderTimetable() {
      const grid = document.getElementById("timetableGrid");
      if (!app.slots.length) {
        grid.innerHTML = `<div class="p-4 text-slate-500 text-xs">No slots found in database.</div>`;
        return;
      }
      grid.innerHTML = app.slots.map(s => `
        <div class="bg-slate-950 border border-slate-800 p-3.5 rounded-xl flex flex-col justify-between">
          <div>
            <span class="text-[10px] font-bold uppercase text-amber-400">${s.day_of_week}</span>
            <div class="text-xs font-mono font-bold text-white mt-1">${s.start_time} - ${s.end_time}</div>
            <p class="text-xs font-semibold text-slate-300 mt-1">${s.course_name}</p>
            <span class="text-[10px] text-slate-500">${s.room || 'Study Hall'}</span>
          </div>
        </div>
      `).join("");
    }

    function renderCourses() {
      const grid = document.getElementById("coursesGrid");
      grid.innerHTML = app.courses.map(c => `
        <div class="bg-slate-900 border border-slate-800 p-4 rounded-xl space-y-3">
          <div class="flex justify-between items-start">
            <span class="px-2 py-0.5 rounded bg-slate-800 text-amber-400 text-xs font-mono font-bold">${c.code}</span>
            <span class="text-xs font-bold text-slate-400">${c.completed} / ${c.planned} sessions</span>
          </div>
          <h4 class="text-sm font-bold text-white">${c.title}</h4>
          <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden">
            <div class="bg-amber-500 h-full" style="width: ${c.planned ? Math.round((c.completed/c.planned)*100) : 0}%"></div>
          </div>
          <div class="text-[11px] text-slate-400">
            Topics: ${c.topics.join(', ')}
          </div>
        </div>
      `).join("");
    }

    function renderMembers() {
      const tbody = document.getElementById("allMembersTable");
      tbody.innerHTML = app.members.map((m, idx) => `
        <tr class="hover:bg-slate-800/40">
          <td class="p-3 font-mono text-slate-400">${m.member_code}</td>
          <td class="p-3 font-bold text-white">${m.full_name}</td>
          <td class="p-3 uppercase font-bold text-xs text-slate-300">${m.role}</td>
          <td class="p-3"><span class="text-[11px] font-bold ${m.is_active ? 'text-emerald-400' : 'text-slate-500'}">${m.is_active ? 'Active' : 'Open Slot'}</span></td>
          <td class="p-3 text-right">
            <button onclick="openEditMemberModal(${idx})" class="owner-restricted px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-amber-400 rounded text-xs font-bold">Edit Profile</button>
          </td>
        </tr>
      `).join("");
    }

    function renderReports() {
      const tbody = document.getElementById("reportsTableBody");
      if (!app.attendance.length) {
        tbody.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-slate-500">No attendance history yet in database.</td></tr>`;
        return;
      }
      tbody.innerHTML = app.attendance.slice(0, 30).map(r => {
        const m = app.members.find(mem => mem.id === r.member_id);
        const name = m ? m.full_name : r.member_id.substring(0, 8);
        return `
          <tr class="hover:bg-slate-800/40">
            <td class="p-3 font-mono text-slate-400">${new Date(r.created_at).toLocaleDateString()}</td>
            <td class="p-3 font-bold text-white">${name}</td>
            <td class="p-3 font-mono text-amber-400">${r.arrival_time || '--:--'}</td>
            <td class="p-3"><span class="status-pill status-${r.status}">${r.status}</span></td>
            <td class="p-3 text-slate-400">${r.recorded_by}</td>
          </tr>
        `;
      }).join("");
    }

    let courseChartInstance = null;
    let attendanceChartInstance = null;

    function renderCharts(onTime, late, absent) {
      const ctx1 = document.getElementById("courseProgressChart");
      if (ctx1) {
        if (courseChartInstance) courseChartInstance.destroy();
        courseChartInstance = new Chart(ctx1, {
          type: 'bar',
          data: {
            labels: app.courses.slice(0, 6).map(c => c.code),
            datasets: [{
              label: '% Topics Covered',
              data: app.courses.slice(0, 6).map(c => c.planned ? Math.round((c.completed / c.planned) * 100) : 0),
              backgroundColor: '#f59e0b',
              borderRadius: 6
            }]
          },
          options: { responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true, max: 100 } } }
        });
      }

      const ctx2 = document.getElementById("attendanceDonutChart");
      if (ctx2) {
        if (attendanceChartInstance) attendanceChartInstance.destroy();
        attendanceChartInstance = new Chart(ctx2, {
          type: 'doughnut',
          data: {
            labels: ['On-Time', 'Late', 'Absent'],
            datasets: [{
              data: [onTime || 0, late || 0, absent || 0],
              backgroundColor: ['#10b981', '#f59e0b', '#ef4444']
            }]
          },
          options: { responsive: true, maintainAspectRatio: false }
        });
      }
    }

    // 7. Navigation Controls
    function switchView(viewKey) {
      document.querySelectorAll(".view-panel").forEach(el => el.classList.add("hidden"));
      const target = document.getElementById(`view-${viewKey}`);
      if (target) target.classList.remove("hidden");

      document.querySelectorAll(".desktop-nav-btn").forEach(btn => {
        if (btn.dataset.target === viewKey) {
          btn.className = "desktop-nav-btn px-3 py-2 rounded-lg text-xs font-semibold bg-slate-800 text-white";
        } else {
          btn.className = "desktop-nav-btn px-3 py-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-white";
        }
      });

      document.querySelectorAll(".mobile-nav-btn").forEach(btn => {
        if (btn.dataset.target === viewKey) {
          btn.classList.add("text-emerald-400");
          btn.classList.remove("text-slate-400");
        } else {
          btn.classList.remove("text-emerald-400");
          btn.classList.add("text-slate-400");
        }
      });

      lucide.createIcons();
    }

    function toggleMobileMoreDrawer() {
      document.getElementById("mobileMoreDrawer").classList.toggle("hidden");
    }

    function closeModal(id) { document.getElementById(id).classList.add("hidden"); }

    function exportPDF() {
      const { jsPDF } = window.jspdf;
      const doc = new jsPDF();
      doc.text("Excellence Hub – Attendance Report", 14, 20);
      doc.setFontSize(10);
      doc.text("KNUST Academic Year 2026/2027", 14, 28);

      const rows = app.attendance.map(r => {
        const m = app.members.find(mem => mem.id === r.member_id);
        return [new Date(r.created_at).toLocaleDateString(), m ? m.full_name : r.member_id, r.arrival_time || '--', r.status.toUpperCase(), r.recorded_by];
      });

      doc.autoTable({
        head: [['Date', 'Member Name', 'Arrival', 'Status', 'Logged By']],
        body: rows,
        startY: 34,
        headStyles: { fillColor: [245, 158, 11] }
      });
      doc.save(`Excellence_Hub_Report.pdf`);
    }

    function exportCSV() {
      let csv = "Date,Member_ID,Status,Arrival,Logged_By\n";
      app.attendance.forEach(r => {
        csv += `"${new Date(r.created_at).toLocaleDateString()}","${r.member_id}","${r.status}","${r.arrival_time || ''}","${r.recorded_by}"\n`;
      });
      const blob = new Blob([csv], { type: "text/csv" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = `Excellence_Hub_Attendance.csv`;
      a.click();
    }

    window.addEventListener("DOMContentLoaded", () => {
      fetchLiveDatabase();
      initRealtimeSync();
    });
  </script>
</body>
</html>
