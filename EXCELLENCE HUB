          const mLate = mRecs.filter(r => r.status === 'late').length;
          const mAbsent = mRecs.filter(r => r.status === 'absent').length;
          const mRate = mRecs.length ? Math.round(((mOnTime + mLate) / mRecs.length) * 100) : 0;

          return `
            <tr class="hover:bg-slate-800/40">
              <td class="p-3 font-mono text-slate-400 font-semibold">${m.member_code}</td>
              <td class="p-3 font-bold text-white">${m.full_name}</td>
