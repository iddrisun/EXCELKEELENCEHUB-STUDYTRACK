<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="theme-color" content="#020617" />
  <title>Excellence Hub | Academic Group Management</title>
  
  <!-- Tailwind CSS & Fonts -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  
  <!-- Supabase JS Client via CDN -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <!-- Chart.js & jsPDF -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.29/jspdf.plugin.autotable.min.js"></script>
  
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace']
          },
          colors: {
            gold: { 400: '#fbbf24', 500: '#f59e0b', 600: '#d97706' },
            hub: { 800: '#1e293b', 900: '#0f172a', 950: '#020617' }
          }
        }
      }
    }
  </script>

  <style>
    .status-ontime { background-color: #064e3b; color: #6ee7b7; border: 1px solid #059669; }
    .status-late   { background-color: #78350f; color: #fde68a; border: 1px solid #d97706; }
    .status-absent { background-color: #7f1d1d; color: #fca5a5; border: 1px solid #dc2626; }
    .status-pill   { display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.2rem 0.6rem; border-radius: 9999px; font-weight: 700; font-size: 0.7rem; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen flex flex-col pb-20 md:pb-6">

  <!-- TOP APP BAR -->
  <header class="border-b border-slate-800 bg-hub-950/90 backdrop-blur sticky top-0 z-40">
    <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between gap-3">
      
      <!-- Brand & Motto -->
      <div class="flex items-center gap-3">
        <div class="h-10 w-10 rounded-xl bg-gradient-to-tr from-amber-500 to-amber-300 flex items-center justify-center font-extrabold text-slate-950 text-xl shadow-lg shadow-amber-500/20 flex-shrink-0">
          EH
        </div>
        <div class="overflow-hidden">
          <h1 class="text-sm sm:text-base font-extrabold tracking-tight text-white flex items-center gap-2 truncate">
            Excellence Hub
            <span class="text-[9px] uppercase bg-amber-500/10 text-amber-400 border border-amber-500/20 px-1.5 py-0.5 rounded font-bold">KNUST</span>
          </h1>
          <p class="text-[10px] text-slate-400 italic truncate">"Excellence Is Our Hallmark"</p>
        </div>
      </div>

      <!-- Sync Indicator & Owner Lock -->
      <div class="flex items-center gap-2">
        <div id="cloudStatusBadge" class="flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-950/40 border border-amber-800 text-amber-300 font-mono">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          <span id="cloudStatusText" class="hidden sm:inline">Connecting...</span>
        </div>

        <button id="ownerLockToggleBtn" onclick="promptOwnerCodeModal()" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-amber-500/10 border border-amber-500/30 text-amber-400 flex items-center gap-1.5 hover:bg-amber-500/20 transition">
          <i data-lucide="lock" id="ownerLockIcon" class="w-3.5 h-3.5"></i>
          <span id="ownerLockStatus">Locked</span>
        </button>
      </div>

      <!-- Desktop Navigation Bar -->
      <nav class="hidden md:flex items-center gap-1">
        <button onclick="switchView('dashboard')" class="desktop-nav-btn px-3 py-2 rounded-lg text-xs font-semibold bg-slate-800 text-white" data-target="dashboard">Dashboard</button>
        <button onclick="switchView('attendance')" class="desktop-nav-btn px-3 py-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-white" data-target="attendance">Register</button>
        <button onclick="switchView('timetable')" class="desktop-nav-btn px-3 py-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-white" data-target="timetable">Timetable</button>
        <button onclick="switchView('courses')" class="desktop-nav-btn px-3 py-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-white" data-target="courses">Courses</button>
        <button onclick="switchView('members')" class="desktop-nav-btn px-3 py-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-white" data-target="members">Members</button>
        <button onclick="switchView('reports')" class="desktop-nav-btn px-3 py-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-white" data-target="reports">Reports</button>
        <button onclick="switchView('settings')" class="desktop-nav-btn px-3 py-2 rounded-lg text-xs font-semibold text-slate-400 hover:text-white" data-target="settings">Settings</button>
      </nav>

    </div>
  </header>

  <!-- MAIN VIEWPORT -->
  <main class="max-w-7xl mx-auto px-4 py-5 flex-1 w-full space-y-6">

    <!-- VIEW 1: DASHBOARD (Starts at 0) -->
    <section id="view-dashboard" class="view-panel space-y-6">
      
      <!-- Metrics Row -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
        <div class="bg-slate-900/90 border border-slate-800 p-4 rounded-2xl">
          <span class="text-[10px] font-bold uppercase text-slate-400 tracking-wider">Meetings Held</span>
          <div class="flex items-baseline justify-between mt-2">
            <h3 class="text-2xl sm:text-3xl font-black text-white" id="dashTotalHeld">0</h3>
            <span class="text-[11px] text-amber-400 font-semibold" id="dashPlannedRatio">0 planned</span>
          </div>
          <div class="w-full bg-slate-800 h-1.5 rounded-full mt-3 overflow-hidden">
            <div id="barPlannedMeetings" class="bg-amber-500 h-full w-0 transition-all duration-500"></div>
          </div>
        </div>

        <div class="bg-slate-900/90 border border-slate-800 p-4 rounded-2xl">
          <span class="text-[10px] font-bold uppercase text-slate-400 tracking-wider">Attendance Rate</span>
          <div class="flex items-baseline justify-between mt-2">
            <h3 class="text-2xl sm:text-3xl font-black text-white" id="dashGroupRate">0%</h3>
            <span class="text-[11px] text-emerald-400 font-semibold">Clean Slate</span>
          </div>
          <div class="w-full bg-slate-800 h-1.5 rounded-full mt-3 overflow-hidden">
            <div id="barGroupAttendance" class="bg-emerald-500 h-full w-0 transition-all duration-500"></div>
          </div>
        </div>

        <div class="bg-slate-900/90 border border-slate-800 p-4 rounded-2xl">
          <span class="text-[10px] font-bold uppercase text-slate-400 tracking-wider">Punctuality Score</span>
          <div class="flex items-baseline justify-between mt-2">
            <h3 class="text-2xl sm:text-3xl font-black text-white" id="dashPunctualityRate">0%</h3>
            <span class="text-[11px] text-yellow-400 font-semibold" id="dashLateCount">0 Late</span>
          </div>
          <div class="w-full bg-slate-800 h-1.5 rounded-full mt-3 overflow-hidden">
            <div id="barPunctuality" class="bg-yellow-500 h-full w-0 transition-all duration-500"></div>
          </div>
        </div>

        <div class="bg-slate-900/90 border border-slate-800 p-4 rounded-2xl">
          <span class="text-[10px] font-bold uppercase text-slate-400 tracking-wider">Active Members</span>
          <div class="flex items-baseline justify-between mt-2">
            <h3 class="text-2xl sm:text-3xl font-black text-white" id="dashActiveMembers">0</h3>
            <span class="text-[11px] text-purple-400 font-semibold">Capacity: 20</span>
          </div>
          <div class="w-full bg-slate-800 h-1.5 rounded-full mt-3 overflow-hidden">
            <div class="bg-purple-500 h-full w-1/3"></div>
          </div>
        </div>
      </div>

      <!-- Quick Action Card -->
      <div class="p-4 bg-gradient-to-r from-amber-500/10 via-amber-500/5 to-transparent border border-amber-500/20 rounded-2xl flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
        <div>
          <h4 class="text-xs font-bold text-amber-300 uppercase tracking-wider">Live Session Controller</h4>
          <p class="text-xs text-slate-300 mt-0.5">Coordinator or Owner can launch a live attendance register slot anytime.</p>
        </div>
        <button onclick="switchView('attendance')" class="px-4 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-xl text-xs flex items-center gap-1.5 shadow-md">
          <i data-lucide="play" class="w-3.5 h-3.5"></i> Open Live Register
        </button>
      </div>

      <!-- Graphical Charts -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 bg-slate-900/90 border border-slate-800 p-4 sm:p-5 rounded-2xl">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-300 mb-3 flex items-center gap-2">
            <i data-lucide="bar-chart-2" class="w-4 h-4 text-amber-400"></i> Course Topics Covered (%)
          </h4>
          <div class="h-56 sm:h-64">
            <canvas id="courseProgressChart"></canvas>
          </div>
        </div>

        <div class="bg-slate-900/90 border border-slate-800 p-4 sm:p-5 rounded-2xl">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-300 mb-3 flex items-center gap-2">
            <i data-lucide="pie-chart" class="w-4 h-4 text-emerald-400"></i> Attendance Status
          </h4>
          <div class="h-56 sm:h-64 flex justify-center items-center">
            <canvas id="attendanceDonutChart"></canvas>
          </div>
        </div>
      </div>

      <!-- Active Roster Snapshot -->
      <div class="bg-slate-900/90 border border-slate-800 rounded-2xl overflow-hidden">
        <div class="p-4 border-b border-slate-800 flex justify-between items-center bg-slate-900/50">
          <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200">Active Roster Snapshot</h4>
          <button onclick="fetchLiveDatabase()" class="text-xs text-amber-400 hover:underline flex items-center gap-1 font-mono">
            <i data-lucide="refresh-cw" class="w-3 h-3"></i> Sync
          </button>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-950 text-slate-400 uppercase font-semibold">
              <tr>
                <th class="p-3">ID</th>
                <th class="p-3">Member Name</th>
                <th class="p-3">Role</th>
                <th class="p-3">On-Time</th>
                <th class="p-3">Late</th>
                <th class="p-3">Absent</th>
                <th class="p-3">Rate</th>
              </tr>
            </thead>
            <tbody id="dashMembersTable" class="divide-y divide-slate-800 text-slate-300">
              <tr><td colspan="7" class="p-4 text-center text-slate-500">Connecting to cloud database...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- VIEW 2: LIVE ATTENDANCE REGISTER -->
    <section id="view-attendance" class="view-panel hidden space-y-5">
      <div class="bg-slate-900/90 border border-slate-800 p-4 sm:p-6 rounded-2xl space-y-4">
        
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 pb-3 border-b border-slate-800">
          <div>
            <h3 class="text-base font-bold text-white flex items-center gap-2">
              <i data-lucide="clipboard-check" class="w-4 h-4 text-emerald-400"></i> Live Attendance Register
            </h3>
            <p class="text-xs text-slate-400 mt-0.5">Records exact arrival timestamps with inclusive grace period check.</p>
          </div>
          <div class="flex items-center gap-2 w-full sm:w-auto">
            <button id="btnOpenRegister" onclick="openStartSessionModal()" class="w-full sm:w-auto px-4 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-bold flex items-center justify-center gap-1.5 shadow-md">
              <i data-lucide="play" class="w-3.5 h-3.5"></i> Launch Meeting Session
            </button>
            <button id="btnCloseRegister" onclick="closeLiveRegister()" class="hidden w-full sm:w-auto px-4 py-2.5 bg-rose-600 hover:bg-rose-500 text-white rounded-xl text-xs font-bold flex items-center justify-center gap-1.5 shadow-md">
              <i data-lucide="check-check" class="w-3.5 h-3.5"></i> Close & Mark Absentees
            </button>
          </div>
        </div>

        <div id="sessionBanner" class="p-4 rounded-xl border border-slate-800 bg-slate-950 text-xs text-slate-400 text-center">
          No meeting session currently open. Tap "Launch Meeting Session" to begin.
        </div>

        <!-- Mobile Touch Cards (Smartphones) -->
        <div class="block md:hidden space-y-2.5" id="mobileAttendanceCards">
          <div class="p-4 text-center text-slate-500 text-xs">No active meeting session.</div>
        </div>

        <!-- Desktop Table (Laptops/Tablets) -->
        <div class="hidden md:block overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-950 text-slate-400 uppercase font-semibold">
              <tr>
                <th class="p-3">ID Code</th>
                <th class="p-3">Member Name</th>
                <th class="p-3">Arrival Time</th>
                <th class="p-3">Punctuality Status</th>
                <th class="p-3">Recorded By</th>
                <th class="p-3 text-right">Instant Action</th>
              </tr>
            </thead>
            <tbody id="desktopRegisterTable" class="divide-y divide-slate-800 text-slate-200">
              <tr><td colspan="6" class="p-4 text-center text-slate-500">Register is currently idle.</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Corrections & Audit History Card -->
      <div class="bg-slate-900/90 border border-slate-800 p-4 sm:p-5 rounded-2xl space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-300 flex items-center gap-2">
          <i data-lucide="shield-check" class="w-4 h-4 text-amber-400"></i> Attendance Modification Audit Log
        </h4>
        <div class="overflow-x-auto max-h-48">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-950 text-slate-500 uppercase">
              <tr>
                <th class="p-2.5">Date & Time</th>
                <th class="p-2.5">Member</th>
                <th class="p-2.5">Action</th>
                <th class="p-2.5">Agent</th>
                <th class="p-2.5">Reason</th>
              </tr>
            </thead>
            <tbody id="auditLogBody" class="divide-y divide-slate-800 text-slate-400">
              <tr><td colspan="5" class="p-3 text-center text-slate-500">No corrections logged yet.</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- VIEW 3: TIMETABLE & SCHEDULER -->
    <section id="view-timetable" class="view-panel hidden space-y-5">
      <div class="bg-slate-900/90 border border-slate-800 p-4 sm:p-6 rounded-2xl space-y-4">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 pb-3 border-b border-slate-800">
          <div>
            <h3 class="text-base font-bold text-white flex items-center gap-2">
              <i data-lucide="calendar" class="w-4 h-4 text-sky-400"></i> Weekly Timetable (5 Meeting Slots)
            </h3>
            <p class="text-xs text-slate-400">Accra Local Time (GMT+0). Flexible guide for regular review meetings.</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3" id="timetableGrid">
          <div class="p-4 text-center text-slate-500 text-xs">Loading timetable slots...</div>
        </div>
      </div>
    </section>

    <!-- VIEW 4: COURSES & TOPICS (10 Slots) -->
    <section id="view-courses" class="view-panel hidden space-y-5">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
        <div>
          <h3 class="text-base font-bold text-white flex items-center gap-2">
            <i data-lucide="book-open" class="w-4 h-4 text-amber-400"></i> 10 Course Modules & Topics
          </h3>
          <p class="text-xs text-slate-400">Formula: Completed Meetings ÷ Planned Meetings × 100</p>
        </div>
        <span class="text-xs text-slate-500 font-mono">Owner can edit all courses</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="coursesGrid"></div>
    </section>

    <!-- VIEW 5: MEMBERS DIRECTORY (20 Member Profiles) -->
    <section id="view-members" class="view-panel hidden space-y-5">
      <div class="bg-slate-900/90 border border-slate-800 p-4 sm:p-6 rounded-2xl space-y-4">
        <div class="flex justify-between items-center pb-3 border-b border-slate-800">
          <div>
            <h3 class="text-base font-bold text-white flex items-center gap-2">
              <i data-lucide="users" class="w-4 h-4 text-emerald-400"></i> Membership Directory (20 Capacity)
            </h3>
            <p class="text-xs text-slate-400">Tap "Edit Profile" on any member to update details.</p>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-950 text-slate-400 uppercase font-semibold">
              <tr>
                <th class="p-3">ID Code</th>
                <th class="p-3">Member Name</th>
                <th class="p-3">Role</th>
                <th class="p-3">Status</th>
                <th class="p-3 text-right">Owner Action</th>
              </tr>
            </thead>
            <tbody id="allMembersTable" class="divide-y divide-slate-800 text-slate-300">
              <tr><td colspan="5" class="p-4 text-center text-slate-500">Loading members...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- VIEW 6: REPORTS & EXPORTS -->
    <section id="view-reports" class="view-panel hidden space-y-5">
      <div class="bg-slate-900/90 border border-slate-800 p-4 sm:p-6 rounded-2xl space-y-4">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 pb-3 border-b border-slate-800">
          <div>
            <h3 class="text-base font-bold text-white flex items-center gap-2">
              <i data-lucide="file-bar-chart" class="w-4 h-4 text-purple-400"></i> Attendance Reports & Downloads
            </h3>
            <p class="text-xs text-slate-400">Historical records saved in cloud database.</p>
          </div>
          <div class="flex items-center gap-2">
            <button onclick="exportCSV()" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-xl text-xs flex items-center gap-1.5 shadow-sm">
              <i data-lucide="file-spreadsheet" class="w-3.5 h-3.5"></i> Export CSV
            </button>
            <button onclick="exportPDF()" class="px-3.5 py-2 bg-rose-600 hover:bg-rose-500 text-white font-bold rounded-xl text-xs flex items-center gap-1.5 shadow-sm">
              <i data-lucide="file-text" class="w-3.5 h-3.5"></i> Download PDF
            </button>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs" id="historicalReportTable">
            <thead class="bg-slate-950 text-slate-400 uppercase font-semibold">
              <tr>
                <th class="p-3">Date</th>
                <th class="p-3">Member Name</th>
                <th class="p-3">Arrival Time</th>
                <th class="p-3">Status</th>
                <th class="p-3">Recorded By</th>
              </tr>
            </thead>
            <tbody id="reportsTableBody" class="divide-y divide-slate-800 text-slate-300">
              <tr><td colspan="5" class="p-4 text-center text-slate-500">No attendance history yet in database.</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- VIEW 7: SETTINGS & RESET TO ZERO -->
    <section id="view-settings" class="view-panel hidden space-y-5">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Group Profile -->
        <div class="bg-slate-900/90 border border-slate-800 p-5 rounded-2xl space-y-3">
          <h3 class="text-sm font-bold text-white pb-2 border-b border-slate-800 flex items-center gap-2">
            <i data-lucide="award" class="w-4 h-4 text-amber-400"></i> Excellence Hub Identity
          </h3>
          <div>
            <label class="text-[11px] text-slate-400 block mb-1">Study Group Name</label>
            <input type="text" id="cfgGroupName" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white" value="Excellence Hub" />
          </div>
          <div>
            <label class="text-[11px] text-slate-400 block mb-1">Motto</label>
            <input type="text" id="cfgMotto" class="w-full bg-slate-950 border border-slate-800 rounded-xl px-3 py-2 text-xs text-white" value="Excellence Is Our Hallmark" />
          </div>
          <button onclick="alert('Profile details saved.')" class="owner-restricted px-4 py-2 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold rounded-xl text-xs">Save Identity</button>
        </div>

        <!-- Reset All Attendance to Clean Zero -->
        <div class="bg-slate-900/90 border border-slate-800 p-5 rounded-2xl space-y-3">
          <h3 class="text-sm font-bold text-white pb-2 border-b border-slate-800 flex items-center gap-2">
            <i data-lucide="rotate-ccw" class="w-4 h-4 text-rose-400"></i> Reset Attendance Records
          </h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Need a fresh start? Resetting clears all recorded attendance sessions back to <b>0</b> while preserving your members and courses.
          </p>
          <div class="pt-2">
            <button onclick="resetAllAttendanceToZero()" class="owner-restricted px-4 py-2.5 bg-rose-700 hover:bg-rose-600 text-white font-bold rounded-xl text-xs flex items-center gap-2 shadow-md">
              <i data-lucide="trash-2" class="w-3.5 h-3.5"></i> Reset All Attendance to Zero
            </button>
          </div>
        </div>

      </div>
    </section>

  </main>

  <!-- MOBILE BOTTOM NAVIGATION (Smartphones Only) -->
  <nav class="md:hidden fixed bottom-0 left-0 right-0 h-16 bg-hub-950/95 border-t border-slate-800 backdrop-blur z-50 flex items-center justify-around px-2">
    <button onclick="switchView('dashboard')" class="mobile-nav-btn flex flex-col items-center gap-1 text-slate-400 hover:text-white" data-target="dashboard">
