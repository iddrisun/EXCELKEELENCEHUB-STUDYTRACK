    // 1. Live Data Fetching
    async function fetchLiveDatabase() {
      const badge = document.getElementById("cloudStatusBadge");
      const badgeText = document.getElementById("cloudStatusText");

      try {
        const { data: members, error: mErr } = await supabase.from('members').select('*').order('member_code', { ascending: true });
        if (!mErr && members) app.members = members;

        const { data: slots, error: sErr } = await supabase.from('timetable_slots').select('*').order('slot_index', { ascending: true });
        if (!sErr && slots) app.slots = slots;

        const { data: records, error: rErr } = await supabase.from('attendance_records').select('*').order('created_at', { ascending: false });
        if (!rErr && records) app.attendance = records;

        const { data: openMtgs, error: mtgErr } = await supabase.from('meetings').select('*').eq('register_is_open', true).limit(1);
        if (!mtgErr && openMtgs && openMtgs.length > 0) {
          app.activeMeeting = openMtgs[0];
        } else {
          app.activeMeeting = null;
        }

        badge.className = "flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-950/40 border border-emerald-800 text-emerald-300 font-mono";
