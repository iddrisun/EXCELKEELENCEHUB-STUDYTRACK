    // 6. Visual Renders
    function renderDashboard() {
      const activeM = app.members.filter(m => m.is_active);
      document.getElementById("dashActiveMembers").innerText = activeM.length;

      const uniqueSessions = new Set(app.attendance.map(r => r.meeting_id)).size;
      document.getElementById("dashTotalHeld").innerText = uniqueSessions;

      const totalRecs = app.attendance.length;
      const present = app.attendance.filter(r => r.status === 'on_time' || r.status === 'late').length;
      const late = app.attendance.filter(r => r.status === 'late').length;
      const onTime = app.attendance.filter(r => r.status === 'on_time').length;

      const rate = totalRecs ? Math.round((present / totalRecs) * 100) : 0;
      const punct = present ? Math.round((onTime / present) * 100) : 0;

      document.getElementById("dashGroupRate").innerText = rate + "%";
      document.getElementById("barGroupAttendance").style.width = rate + "%";
      document.getElementById("dashPunctualityRate").innerText = punct + "%";
      document.getElementById("barPunctuality").style.width = punct + "%";
      document.getElementById("dashLateCount").innerText = `${late} Late`;

      const tbody = document.getElementById("dashMembersTable");
