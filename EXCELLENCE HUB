        badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-rose-500"></span><span id="cloudStatusText" class="hidden sm:inline">Offline</span>`;
      }
      lucide.createIcons();
    }

    // 2. Realtime Webhook Channel
    function initRealtimeSync() {
      supabase
        .channel('excellence_hub_live_channel')
        .on('postgres_changes', { event: '*', schema: 'public', table: 'attendance_records' }, () => fetchLiveDatabase())
        .on('postgres_changes', { event: '*', schema: 'public', table: 'meetings' }, () => fetchLiveDatabase())
        .on('postgres_changes', { event: '*', schema: 'public', table: 'members' }, () => fetchLiveDatabase())
        .subscribe();
    }

    // 3. Attendance Logic
    async function openStartSessionModal() {
      const now = new Date();
      const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false });
      const dateStr = now.toISOString().split("T")[0];

      const { data, error } = await supabase.from('meetings').insert([
        {
          title: "Study Group Session",
          session_date: dateStr,
          start_time: timeStr,
          end_time: "17:30",
          status: "class_held",
          grace_period_mins: 10,
          register_is_open: true
        }
      ]).select();

      if (error) {
        alert("Supabase Error: " + error.message);
        return;
      }

      app.activeMeeting = data[0];
      await fetchLiveDatabase();
    }

    async function recordArrival(memberId, forcedStatus = null) {
      if (!app.activeMeeting) return;

      const now = new Date();
      const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false });

      let status = "on_time";

      if (forcedStatus) {
        status = forcedStatus;
      } else {
        const [sH, sM] = app.activeMeeting.start_time.split(":").map(Number);
        const [aH, aM] = timeStr.split(":").map(Number);
        const startMins = sH * 60 + sM;
        const arrivalMins = aH * 60 + aM;
        const cutoff = startMins + (app.activeMeeting.grace_period_mins || 10);
        status = arrivalMins <= cutoff ? "on_time" : "late";
      }

      const { error } = await supabase.from('attendance_records').upsert([
        {
          meeting_id: app.activeMeeting.id,
          member_id: memberId,
          arrival_time: (status === "absent" ? null : timeStr),
          status: status,
          recorded_by: "Coordinator (Live Check-In)"
        }
      ], { onConflict: 'meeting_id,member_id' });

      if (error) {
        alert("Error saving: " + error.message);
        return;
      }

      await fetchLiveDatabase();
    }

    async function closeLiveRegister() {
      if (!app.activeMeeting) return;
      if (!confirm("Close register? Unchecked active members will be marked Absent in Supabase.")) return;

      const checkedMemberIds = app.attendance
        .filter(r => r.meeting_id === app.activeMeeting.id)
        .map(r => r.member_id);

      const activeMembers = app.members.filter(m => m.is_active);

      for (const m of activeMembers) {
        if (!checkedMemberIds.includes(m.id)) {
          await supabase.from('attendance_records').insert([
            {
              meeting_id: app.activeMeeting.id,
              member_id: m.id,
              status: "absent",
              recorded_by: "Auto-Close"
            }
          ]);
        }
      }

      await supabase.from('meetings').update({ register_is_open: false }).eq('id', app.activeMeeting.id);
      app.activeMeeting = null;
      await fetchLiveDatabase();
      alert("Session finalized and saved to cloud.");
    }

    // 4. Reset Attendance to Zero
    async function resetAllAttendanceToZero() {
      if (!confirm("Are you sure? This will wipe all recorded attendance back to 0 while keeping members and courses.")) return;

      const { error: rErr } = await supabase.from('attendance_records').delete().neq('id', '00000000-0000-0000-0000-000000000000');
      const { error: mErr } = await supabase.from('meetings').delete().neq('id', '00000000-0000-0000-0000-000000000000');

      if (rErr || mErr) {
        alert("Could not reset database: " + (rErr?.message || mErr?.message));
        return;
      }

      app.attendance = [];
      app.activeMeeting = null;
      await fetchLiveDatabase();
      alert("All attendance metrics successfully reset to zero.");
    }

